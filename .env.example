# ---------------------------------------------------------------------------
# iWitness environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, RDS or a local Postgres).
DATABASE_URL="postgresql://iwitness:iwitness@localhost:5432/iwitness?schema=public"

# NextAuth: secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public base URL of the app (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API key used to pre-fill reports from an uploaded photo.
# Optional: without it, image analysis is disabled and users fill the form manually.
GEMINI_API_KEY=""
# Gemini model used for image analysis.
GEMINI_MODEL="gemini-2.5-flash"

# Mapbox public access token for address autocomplete. Optional: without it the
# location field is a plain text input (GPS "use my location" still works).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Used by `npm run db:seed` to create the first administrator account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
